APP_REPOSITORY_POSTGRES_ADDRESS=catalog-postgres:5432
APP_REPOSITORY_POSTGRES_NAME=catalog_db
APP_REPOSITORY_POSTGRES_USERNAME=catalog_user
APP_REPOSITORY_POSTGRES_PASSWORD=catalog_pass
APP_REPOSITORY_POSTGRES_READ_TIMEOUT=30s
APP_REPOSITORY_POSTGRES_WRITE_TIMEOUT=30s
APP_REPOSITORY_POSTGRES_MIGRATION_TABLE=schema_migrations

APP_PROCESSOR_WEB_SERVER_LISTEN_PORT=8080
APP_PROCESSOR_GRPC_LISTEN_PORT=50051
APP_PROCESSOR_GATEWAY_LISTEN_PORT=8081

APP_MONITOR_LOG_LEVEL=debug
APP_MONITOR_ENVIRONMENT=development

APP_MONITOR_SENTRY_ENABLED=false
APP_MONITOR_SENTRY_DSN=

APP_MONITOR_OPEN_TELEMETRY_ENABLED=false
APP_MONITOR_OPEN_TELEMETRY_ADDRESS=jaeger:4317
APP_MONITOR_OPEN_TELEMETRY_MAX_QUEUE_SIZE=2048
APP_MONITOR_OPEN_TELEMETRY_MAX_BATCH_SIZE=512
APP_MONITOR_OPEN_TELEMETRY_SEND_BATCH_TIMEOUT=5s
APP_MONITOR_OPEN_TELEMETRY_EXPORT_TIMEOUT=30s
APP_MONITOR_OPEN_TELEMETRY_SAMPLE_RATIO=1
